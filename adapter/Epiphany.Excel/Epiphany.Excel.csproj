<Project Sdk="Microsoft.NET.Sdk">

  <!-- The .NET Framework is part of Windows, so the add-in needs nothing installed beside Excel. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Epiphany.Excel</RootNamespace>
    <ExcelAddInName>Epiphany</ExcelAddInName>
    <ExcelAddInFileName>Epiphany</ExcelAddInFileName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ExcelDna.AddIn" Version="1.9.0" />
    <!-- Excel's own object model. Its types are compiled into the add-in, so nothing ships. -->
    <PackageReference Include="ExcelDna.Interop" Version="15.0.1" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
