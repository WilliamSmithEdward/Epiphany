# Copy to .env.local (not committed) and edit. One NAME=value per line. start.cmd reads it.

# The address the server listens on. Keep it on 127.0.0.1 while the sample has no users:
# without them it asks for no sign-in.
EPIPHANY_SERVER=127.0.0.1:8080

# The address the GUI listens on, which the browser opens.
EPIPHANY_GUI=127.0.0.1:8090
