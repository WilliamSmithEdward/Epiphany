{
  "openapi": "3.1.0",
  "info": {
    "title": "Epiphany",
    "description": "An in-memory OLAP server.",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/cells/read": {
      "post": {
        "summary": "Reads a batch of cells. A cell that cannot be read reports its own error.",
        "operationId": "read_cells",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadResponse"
                }
              }
            }
          }
        }
      }
    },
    "/cells/write": {
      "post": {
        "summary": "Writes a batch of leaf cells: all of them, or none if any is refused.",
        "operationId": "write_cells",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WriteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {},
          "404": {
            "description": "Unknown transaction",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Another transaction holds a lock",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "A write is invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/dimensions/{name}": {
      "get": {
        "summary": "One dimension, with each element's level, parents, children and attributes.",
        "operationId": "get_dimension",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Dimension name, ignoring case and spaces",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DimensionView"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/mdx": {
      "post": {
        "summary": "Answers an MDX query.",
        "operationId": "query",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResult"
                }
              }
            }
          },
          "404": {
            "description": "Unknown transaction",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "The query is invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/model": {
      "get": {
        "summary": "The model definition and its version.",
        "operationId": "get_model",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelView"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Replaces the model in one step. Stored cells that still fit the new model are kept.",
        "operationId": "put_model",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ModelPut"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelUpdate"
                }
              }
            }
          },
          "409": {
            "description": "Stale version, or a transaction holds a lock",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "The definition is invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/transactions": {
      "post": {
        "summary": "Begins a transaction. It is rolled back if left idle.",
        "operationId": "begin_transaction",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionView"
                }
              }
            }
          }
        }
      }
    },
    "/transactions/{id}/commit": {
      "post": {
        "summary": "Stores a transaction's pending writes in one step and ends it.",
        "operationId": "commit_transaction",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/u64"
            }
          }
        ],
        "responses": {
          "204": {},
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/transactions/{id}/locks": {
      "post": {
        "summary": "Locks a cube or the whole server for a transaction until it ends.",
        "operationId": "lock",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/u64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LockRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {},
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Another transaction holds a conflicting lock",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/transactions/{id}/rollback": {
      "post": {
        "summary": "Discards a transaction's pending writes and ends it.",
        "operationId": "rollback_transaction",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/u64"
            }
          }
        ],
        "responses": {
          "204": {},
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "description": "The one error shape used by every route.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "A stable identifier for the kind of error."
          },
          "index": {
            "type": [
              "integer",
              "null"
            ],
            "description": "The position of the offending cell in a batch.",
            "minimum": 0
          },
          "message": {
            "type": "string"
          }
        }
      },
      "AttributeType": {
        "type": "string",
        "enum": [
          "string",
          "numeric",
          "alias"
        ]
      },
      "AxisResult": {
        "type": "object",
        "required": [
          "tuples"
        ],
        "properties": {
          "tuples": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/MemberResult"
              }
            },
            "description": "Each tuple holds one member per dimension on the axis."
          }
        }
      },
      "CellRef": {
        "type": "object",
        "description": "A cell addressed by cube name and one element name or alias per dimension.",
        "required": [
          "cube",
          "at"
        ],
        "properties": {
          "at": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cube": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CellResult": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "value"
            ],
            "properties": {
              "value": {}
            }
          },
          {
            "type": "object",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "$ref": "#/components/schemas/ApiError"
              }
            }
          }
        ]
      },
      "CellWrite": {
        "type": "object",
        "description": "A value to write to a leaf cell.",
        "required": [
          "cube",
          "at",
          "value"
        ],
        "properties": {
          "at": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cube": {
            "type": "string"
          },
          "value": {}
        },
        "additionalProperties": false
      },
      "ChildDef": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "CubeDef": {
        "type": "object",
        "required": [
          "name",
          "dimensions"
        ],
        "properties": {
          "dimensions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "DimensionDef": {
        "type": "object",
        "required": [
          "name",
          "elements"
        ],
        "properties": {
          "attributes": {
            "type": "object",
            "description": "Declared attributes and their types. Elements may only carry attributes declared here.",
            "additionalProperties": {
              "$ref": "#/components/schemas/AttributeType"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "elements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ElementDef"
            }
          },
          "name": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/DimensionType"
          }
        },
        "additionalProperties": false
      },
      "DimensionType": {
        "type": "string",
        "enum": [
          "standard"
        ]
      },
      "DimensionView": {
        "type": "object",
        "description": "A dimension with the hierarchy facts derived from its definition.",
        "required": [
          "name",
          "attributes",
          "elements"
        ],
        "properties": {
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/AttributeType"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "elements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ElementView"
            },
            "description": "Elements in declaration order."
          },
          "name": {
            "type": "string"
          }
        }
      },
      "ElementDef": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "attributes": {
            "type": "object",
            "description": "Attribute values, keyed by attribute name.",
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            }
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChildDef"
            },
            "description": "Weighted children, in order. Present on consolidated elements only."
          },
          "name": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/ElementType"
          }
        },
        "additionalProperties": false
      },
      "ElementType": {
        "type": "string",
        "enum": [
          "numeric",
          "string",
          "consolidated"
        ]
      },
      "ElementView": {
        "type": "object",
        "required": [
          "name",
          "type",
          "level",
          "parents",
          "children",
          "attributes"
        ],
        "properties": {
          "attributes": {
            "type": "object",
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            }
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChildDef"
            }
          },
          "level": {
            "type": "integer",
            "format": "int32",
            "description": "Zero for a leaf, otherwise one more than the highest child level.",
            "minimum": 0
          },
          "name": {
            "type": "string"
          },
          "parents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "type": {
            "$ref": "#/components/schemas/ElementType"
          }
        }
      },
      "LockMode": {
        "type": "string",
        "description": "A lock a client may ask for.",
        "enum": [
          "shared",
          "exclusive"
        ]
      },
      "LockRequest": {
        "type": "object",
        "required": [
          "mode"
        ],
        "properties": {
          "cube": {
            "type": [
              "string",
              "null"
            ],
            "description": "The cube to lock. Without it the whole server is locked."
          },
          "mode": {
            "$ref": "#/components/schemas/LockMode"
          }
        },
        "additionalProperties": false
      },
      "MemberResult": {
        "type": "object",
        "required": [
          "dimension",
          "name",
          "unique_name",
          "type",
          "level",
          "properties"
        ],
        "properties": {
          "dimension": {
            "type": "string"
          },
          "level": {
            "type": "integer",
            "format": "int32",
            "description": "Zero for a leaf or a calculated member, otherwise one more than the highest child level.",
            "minimum": 0
          },
          "name": {
            "type": "string"
          },
          "properties": {
            "type": "object",
            "description": "The attributes asked for with `PROPERTIES`, where the member has a value for them.",
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            }
          },
          "type": {
            "$ref": "#/components/schemas/MemberType"
          },
          "unique_name": {
            "type": "string"
          }
        }
      },
      "MemberType": {
        "type": "string",
        "enum": [
          "numeric",
          "string",
          "consolidated",
          "calculated"
        ]
      },
      "ModelDef": {
        "type": "object",
        "properties": {
          "cubes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CubeDef"
            }
          },
          "dimensions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DimensionDef"
            }
          }
        },
        "additionalProperties": false
      },
      "ModelPut": {
        "type": "object",
        "required": [
          "based_on",
          "model"
        ],
        "properties": {
          "based_on": {
            "type": "integer",
            "format": "int64",
            "description": "The version the new definition was edited from. The update is refused if it is no\nlonger the current version.",
            "minimum": 0
          },
          "model": {
            "$ref": "#/components/schemas/ModelDef"
          }
        },
        "additionalProperties": false
      },
      "ModelUpdate": {
        "type": "object",
        "description": "The outcome of a model update.",
        "required": [
          "version",
          "dropped_cells"
        ],
        "properties": {
          "dropped_cells": {
            "type": "integer",
            "description": "Stored cells that have no place in the new model and were discarded.",
            "minimum": 0
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "description": "The new model version.",
            "minimum": 0
          }
        }
      },
      "ModelView": {
        "type": "object",
        "description": "The model definition and its version.",
        "required": [
          "version",
          "model"
        ],
        "properties": {
          "model": {
            "$ref": "#/components/schemas/ModelDef"
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "description": "Counts up by one with every update.",
            "minimum": 0
          }
        }
      },
      "QueryRequest": {
        "type": "object",
        "required": [
          "mdx"
        ],
        "properties": {
          "mdx": {
            "type": "string",
            "description": "The query text, for example `SELECT {[Entity].[US]} ON COLUMNS FROM [General Ledger]`."
          },
          "transaction": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/u64",
                "description": "Query within this transaction, seeing its pending writes."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "QueryResult": {
        "type": "object",
        "description": "The answer to a query.\n\nWith columns and rows, `cells` holds one value per pair of tuples, row by row: the cell of\nrow `r` and column `c` is at `r * columns + c`. With columns only there is one cell per\ncolumn, and with no axes a single cell. A cell with no value, such as a division by zero,\nis null.",
        "required": [
          "cube",
          "axes",
          "cells"
        ],
        "properties": {
          "axes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AxisResult"
            },
            "description": "The columns axis, then the rows axis, as far as the query has them."
          },
          "cells": {
            "type": "array",
            "items": {}
          },
          "cube": {
            "type": "string"
          }
        }
      },
      "ReadRequest": {
        "type": "object",
        "required": [
          "cells"
        ],
        "properties": {
          "cells": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CellRef"
            }
          },
          "transaction": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/u64",
                "description": "Read within this transaction, seeing its pending writes."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "ReadResponse": {
        "type": "object",
        "required": [
          "cells"
        ],
        "properties": {
          "cells": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CellResult"
            },
            "description": "One result per requested cell, in request order."
          }
        }
      },
      "TransactionView": {
        "type": "object",
        "required": [
          "transaction"
        ],
        "properties": {
          "transaction": {
            "$ref": "#/components/schemas/u64"
          }
        }
      },
      "WriteRequest": {
        "type": "object",
        "required": [
          "cells"
        ],
        "properties": {
          "cells": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CellWrite"
            }
          },
          "transaction": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/u64",
                "description": "Hold the writes in this transaction until it commits. Without it they are committed\nat once."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "u64": {
        "type": "integer",
        "format": "int64",
        "minimum": 0
      }
    }
  }
}
