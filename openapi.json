{
  "openapi": "3.1.0",
  "info": {
    "title": "Epiphany",
    "description": "An in-memory OLAP server.",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/cells/read": {
      "post": {
        "summary": "Reads a batch of cells. A cell that cannot be read reports its own error.",
        "operationId": "read_cells",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "A value or an error for each cell",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadResponse"
                }
              }
            }
          },
          "422": {
            "description": "The request body is malformed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/cells/write": {
      "post": {
        "summary": "Writes a batch of leaf cells: all of them, or none if any is refused.",
        "operationId": "write_cells",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WriteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Done"
          },
          "404": {
            "description": "Unknown transaction",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Another transaction holds a lock",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "A write is invalid, or the request body is malformed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "The change could not be stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/cubes/{cube}/feeders/check": {
      "get": {
        "summary": "Looks for leaf cells that a rule gives a value but no feeder feeds, which a fed cube's\nconsolidations therefore leave out. It works every calculated leaf out, so it is slow on\na large cube. At most a hundred cells are returned; none means the feeders are complete\nfor the data held, or the cube is not fed.",
        "operationId": "check_feeders",
        "parameters": [
          {
            "name": "cube",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The cells found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeederCheck"
                }
              }
            }
          },
          "422": {
            "description": "Unknown cube, or a rule failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/cubes/{cube}/views/{view}": {
      "get": {
        "summary": "Runs a view saved with a cube.",
        "operationId": "run_view",
        "parameters": [
          {
            "name": "cube",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "view",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResult"
                }
              }
            }
          },
          "404": {
            "description": "The cube has no such view",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Unknown cube",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/dimensions/{name}": {
      "get": {
        "summary": "One dimension, with each element's level, parents, children and attributes.",
        "operationId": "get_dimension",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Dimension name, ignoring case and spaces",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The dimension",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DimensionView"
                }
              }
            }
          },
          "404": {
            "description": "Unknown dimension",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/mdx": {
      "post": {
        "summary": "Answers an MDX query.",
        "operationId": "query",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResult"
                }
              }
            }
          },
          "404": {
            "description": "Unknown transaction",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "The query is invalid, or the request body is malformed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/model": {
      "get": {
        "summary": "The model definition and its version.",
        "operationId": "get_model",
        "responses": {
          "200": {
            "description": "The model",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelView"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Replaces the model in one step. Stored cells that still fit the new model are kept.",
        "operationId": "put_model",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ModelPut"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The model was replaced",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelUpdate"
                }
              }
            }
          },
          "409": {
            "description": "Stale version, or a transaction holds a lock",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "The definition is invalid, or the request body is malformed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "The change could not be stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/transactions": {
      "post": {
        "summary": "Begins a transaction. It is rolled back if left idle.",
        "operationId": "begin_transaction",
        "responses": {
          "201": {
            "description": "The new transaction",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionView"
                }
              }
            }
          }
        }
      }
    },
    "/transactions/{id}/commit": {
      "post": {
        "summary": "Stores a transaction's pending writes in one step and ends it.",
        "operationId": "commit_transaction",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Done"
          },
          "404": {
            "description": "Unknown transaction",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "The change could not be stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/transactions/{id}/locks": {
      "post": {
        "summary": "Locks a cube or the whole server for a transaction until it ends.",
        "operationId": "lock",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LockRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Done"
          },
          "404": {
            "description": "Unknown transaction",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Another transaction holds a conflicting lock",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Unknown cube, or the request body is malformed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/transactions/{id}/rollback": {
      "post": {
        "summary": "Discards a transaction's pending writes and ends it.",
        "operationId": "rollback_transaction",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Done"
          },
          "404": {
            "description": "Unknown transaction",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "description": "The one error shape used by every route.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "A stable identifier for the kind of error."
          },
          "index": {
            "type": [
              "integer",
              "null"
            ],
            "description": "The position of the offending cell in a batch.",
            "minimum": 0
          },
          "message": {
            "type": "string"
          }
        }
      },
      "AttributeType": {
        "type": "string",
        "enum": [
          "string",
          "numeric",
          "alias"
        ]
      },
      "AxisResult": {
        "type": "object",
        "required": [
          "tuples"
        ],
        "properties": {
          "tuples": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/MemberResult"
              }
            },
            "description": "Each tuple holds one member per dimension on the axis."
          }
        }
      },
      "CellRef": {
        "type": "object",
        "description": "A cell addressed by cube name and one element name or alias per dimension.",
        "required": [
          "cube",
          "at"
        ],
        "properties": {
          "at": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cube": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CellResult": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "$ref": "#/components/schemas/Scalar"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "$ref": "#/components/schemas/ApiError"
              }
            }
          }
        ]
      },
      "CellWrite": {
        "type": "object",
        "description": "A value to write to a leaf cell.",
        "required": [
          "cube",
          "at",
          "value"
        ],
        "properties": {
          "at": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cube": {
            "type": "string"
          },
          "value": {
            "$ref": "#/components/schemas/Scalar"
          }
        },
        "additionalProperties": false
      },
      "ChildDef": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "CubeDef": {
        "type": "object",
        "required": [
          "name",
          "dimensions"
        ],
        "properties": {
          "dimensions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "feeders": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Statements that say which calculated leaf cells may hold a value, each\n`source => target, ...`, such as `[Account].[Revenue] => [Account].[Margin]`. A cube\nthat is fed consolidates only its stored and fed cells."
          },
          "name": {
            "type": "string"
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Statements that calculate cells, each `[N: | C: | S:] area = expression`. The area is a\nmember or a tuple, such as `[Account].[Margin]`; the expression is written as in MDX.\nThe first rule that covers a cell decides it."
          },
          "views": {
            "type": "object",
            "description": "Saved queries against this cube, by name.",
            "additionalProperties": {
              "$ref": "#/components/schemas/ViewDef"
            },
            "propertyNames": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "DimensionDef": {
        "type": "object",
        "required": [
          "name",
          "elements"
        ],
        "properties": {
          "attributes": {
            "type": "object",
            "description": "Declared attributes and their types. Elements may only carry attributes declared here.",
            "additionalProperties": {
              "$ref": "#/components/schemas/AttributeType"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "elements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ElementDef"
            }
          },
          "name": {
            "type": "string"
          },
          "subsets": {
            "type": "object",
            "description": "Reusable selections of this dimension's elements, by name.",
            "additionalProperties": {
              "$ref": "#/components/schemas/SubsetDef"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "type": {
            "$ref": "#/components/schemas/DimensionType"
          }
        },
        "additionalProperties": false
      },
      "DimensionType": {
        "type": "string",
        "enum": [
          "standard"
        ]
      },
      "DimensionView": {
        "type": "object",
        "description": "A dimension with the hierarchy facts derived from its definition.",
        "required": [
          "name",
          "attributes",
          "elements",
          "subsets"
        ],
        "properties": {
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/AttributeType"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "elements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ElementView"
            },
            "description": "Elements in declaration order."
          },
          "name": {
            "type": "string"
          },
          "subsets": {
            "type": "object",
            "description": "The element names each subset selects, in the subset's order.",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "propertyNames": {
              "type": "string"
            }
          }
        }
      },
      "ElementDef": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "attributes": {
            "type": "object",
            "description": "Attribute values, keyed by attribute name.",
            "additionalProperties": {
              "$ref": "#/components/schemas/Scalar"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChildDef"
            },
            "description": "Weighted children, in order. Present on consolidated elements only."
          },
          "name": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/ElementType"
          }
        },
        "additionalProperties": false
      },
      "ElementType": {
        "type": "string",
        "enum": [
          "numeric",
          "string",
          "consolidated"
        ]
      },
      "ElementView": {
        "type": "object",
        "required": [
          "name",
          "type",
          "level",
          "parents",
          "children",
          "attributes"
        ],
        "properties": {
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/Scalar"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChildDef"
            }
          },
          "level": {
            "type": "integer",
            "format": "int32",
            "description": "Zero for a leaf, otherwise one more than the highest child level.",
            "minimum": 0
          },
          "name": {
            "type": "string"
          },
          "parents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "type": {
            "$ref": "#/components/schemas/ElementType"
          }
        }
      },
      "FeederCheck": {
        "type": "object",
        "required": [
          "unfed"
        ],
        "properties": {
          "unfed": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CellRef"
            },
            "description": "Calculated leaf cells that hold a value but are not fed."
          }
        }
      },
      "LockMode": {
        "type": "string",
        "description": "A lock a client may ask for.",
        "enum": [
          "shared",
          "exclusive"
        ]
      },
      "LockRequest": {
        "type": "object",
        "required": [
          "mode"
        ],
        "properties": {
          "cube": {
            "type": [
              "string",
              "null"
            ],
            "description": "The cube to lock. Without it the whole server is locked."
          },
          "mode": {
            "$ref": "#/components/schemas/LockMode"
          }
        },
        "additionalProperties": false
      },
      "MemberResult": {
        "type": "object",
        "required": [
          "dimension",
          "name",
          "unique_name",
          "type",
          "level",
          "properties"
        ],
        "properties": {
          "dimension": {
            "type": "string"
          },
          "level": {
            "type": "integer",
            "format": "int32",
            "description": "Zero for a leaf or a calculated member, otherwise one more than the highest child level.",
            "minimum": 0
          },
          "name": {
            "type": "string"
          },
          "properties": {
            "type": "object",
            "description": "The attributes asked for with `PROPERTIES`, where the member has a value for them.",
            "additionalProperties": {
              "$ref": "#/components/schemas/Scalar"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "type": {
            "$ref": "#/components/schemas/MemberType"
          },
          "unique_name": {
            "type": "string"
          }
        }
      },
      "MemberType": {
        "type": "string",
        "enum": [
          "numeric",
          "string",
          "consolidated",
          "calculated"
        ]
      },
      "ModelDef": {
        "type": "object",
        "properties": {
          "cubes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CubeDef"
            }
          },
          "dimensions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DimensionDef"
            }
          }
        },
        "additionalProperties": false
      },
      "ModelPut": {
        "type": "object",
        "required": [
          "based_on",
          "model"
        ],
        "properties": {
          "based_on": {
            "type": "integer",
            "format": "int64",
            "description": "The version the new definition was edited from. The update is refused if it is no\nlonger the current version.",
            "minimum": 0
          },
          "model": {
            "$ref": "#/components/schemas/ModelDef"
          }
        },
        "additionalProperties": false
      },
      "ModelUpdate": {
        "type": "object",
        "description": "The outcome of a model update.",
        "required": [
          "version",
          "dropped_cells"
        ],
        "properties": {
          "dropped_cells": {
            "type": "integer",
            "description": "Stored cells that have no place in the new model and were discarded.",
            "minimum": 0
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "description": "The new model version.",
            "minimum": 0
          }
        }
      },
      "ModelView": {
        "type": "object",
        "description": "The model definition and its version.",
        "required": [
          "version",
          "model"
        ],
        "properties": {
          "model": {
            "$ref": "#/components/schemas/ModelDef"
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "description": "Counts up by one with every update.",
            "minimum": 0
          }
        }
      },
      "QueryRequest": {
        "type": "object",
        "required": [
          "mdx"
        ],
        "properties": {
          "mdx": {
            "type": "string",
            "description": "The query text, for example `SELECT {[Entity].[US]} ON COLUMNS FROM [General Ledger]`."
          },
          "transaction": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Query within this transaction, seeing its pending writes.",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "QueryResult": {
        "type": "object",
        "description": "The answer to a query.\n\n`cells` holds one value per combination of a tuple from each axis, the first axis varying\nfastest. With columns and rows that is row by row: the cell of row `r` and column `c` is at\n`r * columns + c`. With columns only there is one cell per column, and with no axes a\nsingle cell. A cell with no value, such as a division by zero, is null.",
        "required": [
          "cube",
          "axes",
          "slicer",
          "cells"
        ],
        "properties": {
          "axes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AxisResult"
            },
            "description": "The columns axis, then the rows axis, then any further axes the query has."
          },
          "cells": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/Scalar"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "cube": {
            "type": "string"
          },
          "slicer": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemberResult"
            },
            "description": "The members the `WHERE` clause narrows the query to. A dimension that is neither here\nnor on an axis stands at its first top element."
          }
        }
      },
      "ReadRequest": {
        "type": "object",
        "required": [
          "cells"
        ],
        "properties": {
          "cells": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CellRef"
            }
          },
          "transaction": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Read within this transaction, seeing its pending writes.",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "ReadResponse": {
        "type": "object",
        "required": [
          "cells"
        ],
        "properties": {
          "cells": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CellResult"
            },
            "description": "One result per requested cell, in request order."
          }
        }
      },
      "Scalar": {
        "oneOf": [
          {
            "type": "number",
            "format": "double"
          },
          {
            "type": "string"
          }
        ]
      },
      "SubsetDef": {
        "oneOf": [
          {
            "type": "object",
            "description": "The elements, by name or alias, in the order given.",
            "required": [
              "elements"
            ],
            "properties": {
              "elements": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The elements, by name or alias, in the order given."
              }
            }
          },
          {
            "type": "object",
            "description": "An MDX set over the dimension, such as `TM1FilterByLevel([Period].Members, 0)`. It is\nworked out from the dimension alone, so it cannot depend on cell values.",
            "required": [
              "mdx"
            ],
            "properties": {
              "mdx": {
                "type": "string",
                "description": "An MDX set over the dimension, such as `TM1FilterByLevel([Period].Members, 0)`. It is\nworked out from the dimension alone, so it cannot depend on cell values."
              }
            }
          }
        ],
        "description": "A selection of a dimension's elements."
      },
      "TransactionView": {
        "type": "object",
        "required": [
          "transaction"
        ],
        "properties": {
          "transaction": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "ViewDef": {
        "type": "object",
        "description": "A saved query against a cube.",
        "required": [
          "mdx"
        ],
        "properties": {
          "mdx": {
            "type": "string",
            "description": "The MDX query, which must select from the cube the view belongs to."
          }
        },
        "additionalProperties": false
      },
      "WriteRequest": {
        "type": "object",
        "required": [
          "cells"
        ],
        "properties": {
          "cells": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CellWrite"
            }
          },
          "transaction": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Hold the writes in this transaction until it commits. Without it they are committed\nat once.",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  }
}
