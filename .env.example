# Epiphany configuration. Copy to `.env` for local use; never commit real secrets.
# Phase 0 requires no configuration. These are illustrative (see docs/DEPLOYMENT.md
# for the full list). Booleans accept 1/true/yes/on or 0/false/no/off.

# EPIPHANY_BIND=127.0.0.1:8080          # address to bind (IP:PORT; hostnames are not resolved)
# EPIPHANY_DATA_DIR=./data
# EPIPHANY_LOG=info

# Optional HTTPS (ADR-0019): `on` serves an auto-generated self-signed cert;
# `off` is plain HTTP. An unrecognized value refuses to start (fail-closed).
# EPIPHANY_TLS=on
# EPIPHANY_TLS_CERT=/etc/epiphany/cert.pem
# EPIPHANY_TLS_KEY=/etc/epiphany/key.pem

# Force the session cookie's Secure attribute when TLS is terminated at a reverse
# proxy and this backend serves plain HTTP; otherwise it follows the served scheme.
# EPIPHANY_SECURE_COOKIES=1
